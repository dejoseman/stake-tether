# Copy to .env and fill in. The app refuses to start if the required values
# below are missing or still set to placeholders.

# --- Required ---------------------------------------------------------------

# Signing key for JWTs. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# There is no longer a fallback value in the source. If you are rotating this,
# be aware that every existing session is invalidated — that is intentional.
JWT_SECRET=

MONGODB_URI=mongodb://localhost:27017/tether

# --- Server -----------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Number of reverse proxies in front of the app. Set to match your deployment
# (1 behind a single load balancer / Nginx). Getting this wrong makes the rate
# limiter key on the proxy IP instead of the client's.
TRUST_PROXY_HOPS=1

# Public origin, used to build password reset links.
APP_URL=https://generatingpro.com

# Comma-separated CORS allowlist. Defaults to the production domains when
# NODE_ENV=production, and additionally allows localhost otherwise.
# CORS_ORIGINS=https://generatingpro.com,https://www.generatingpro.com

# How long an access token stays valid.
JWT_EXPIRES_IN=7d

# --- Background jobs --------------------------------------------------------

# The staking cron must run on EXACTLY ONE instance. Two instances processing
# the same stakes will double-credit every payout. Set RUN_CRON=false on every
# instance except one.
RUN_CRON=true

# --- Storage ----------------------------------------------------------------

# Where KYC documents are written. Point this at a mounted persistent volume —
# container filesystems are ephemeral, and a redeploy would otherwise destroy
# documents that have already been reviewed.
KYC_UPLOAD_DIR=/app/uploads

# --- Email ------------------------------------------------------------------
# If EMAIL_USER or EMAIL_PASS is unset, emails are logged to the console
# instead of being sent.

EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
FROM_EMAIL=support@generatingpro.com
ADMIN_EMAIL=support@generatingpro.com
